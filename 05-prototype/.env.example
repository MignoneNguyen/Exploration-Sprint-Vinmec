# Sao chép file này thành .env rồi điền khóa. File .env đã nằm trong .gitignore, không đưa lên GitHub.
# Chỉ cần MỘT khóa. Không có khóa nào thì prototype chạy chế độ mẫu, không AI.

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# GPT (OpenAI)
OPENAI_API_KEY=
# Tên mô hình OpenAI. Để trống thì dùng gpt-5. Xem danh sách mô hình mà khóa của bạn dùng được trên trang OpenAI Platform.
OPENAI_MODEL=

# Có cả hai khóa thì chọn: anthropic hoặc openai. Để trống thì ưu tiên Anthropic.
AI_PROVIDER=

# Cổng máy chủ cục bộ (mặc định 3000)
# PORT=3000
